# Optional. The app ships a branded style at
# public/brand/map/incident-slate.json and uses it by default; set this
# only to point at a different basemap.
# VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
MONGODB_URI="mongodb+srv://<username>:<password>@<atlas-cluster>/?retryWrites=true&w=majority&appName=<cluster-name>"

# Atlas Model API key for multimodal search (VoyageAI embeddings)
ATLAS_MODEL_API_KEY=your-atlas-model-api-key
# --- Chat assistant ---

# Anthropic API key, read by the visualizer's own server. Server-side only:
# anything VITE_-prefixed is compiled into the browser bundle.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
#CLAUDE_MODEL=claude-opus-5
